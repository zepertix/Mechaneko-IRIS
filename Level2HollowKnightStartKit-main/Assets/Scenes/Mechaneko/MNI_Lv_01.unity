  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  minTalkDistance: 0
  target: {fileID: 507547206}
  dialogueLines:
  - text: Up ahead is the scrapyard, I can see the entrance!
    chathead: {fileID: 3951341223561700399, guid: 07ca2c08838c9bb4c90f5953afb15046,
      type: 3}
  - text: What's that in the way though? It doesn't look too friendly.
    chathead: {fileID: -2585701488230951374, guid: c2493b9dfa71e14429493782bda853f2,
      type: 3}
  - text: Let's kill it.
    chathead: {fileID: -2585701488230951374, guid: c2493b9dfa71e14429493782bda853f2,
      type: 3}
  - text: Alright, let's do it! What do you think Iris?
    chathead: {fileID: 3951341223561700399, guid: 07ca2c08838c9bb4c90f5953afb15046,
      type: 3}
  - text: Meow.
    chathead: {fileID: 1075993247170539406, guid: e38cba1440dd4e64dbf6882912b58dc2,
      type: 3}
